# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB — local install or MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/teamsync

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Seed the database automatically on first start if it is empty (true/false)
AUTO_SEED=true
